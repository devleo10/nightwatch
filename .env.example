# Local Redis for the demo and the BullMQ integration test.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# TypeSafe Jev. The demo and TRIAGE_CLASSIFIER=jev read this.
# Get a key from https://docs.typesafe.ai/introduction/quickstart
# TYPESAFE_API_KEY=

# Optional HTTP server (packages/server). Defaults leave the queue alone.
PORT=4000
TRIAGE_CLASSIFIER=jev
TRIAGE_DRY_RUN=true
TRIAGE_MIN_CONFIDENCE=0.8
TRIAGE_MAX_AUTO_RETRIES=3
TRIAGE_TIMEOUT_MS=1500
# TRIAGE_HTTP_URL=
# TRIAGE_HTTP_HEADERS=
# TRIAGE_API_KEY=
# TRIAGE_DECISION_LOG=
# TRIAGE_NEVER_AUTO_HANDLE=
# TRIAGE_CONFIG=
