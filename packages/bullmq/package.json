{
  "name": "@devleo10/nightwatch",
  "version": "0.1.1",
  "description": "BullMQ adapter for Nightwatch. Import it from @devleo10/nightwatch/bullmq.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devleo10/nightwatch.git",
    "directory": "packages/bullmq"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@devleo10/nightwatch-core": "0.1.1"
  },
  "peerDependencies": {
    "bullmq": ">=5.0.0"
  },
  "devDependencies": {
    "bullmq": "^5.58.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
